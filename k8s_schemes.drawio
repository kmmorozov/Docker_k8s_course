  <diagram id="p2-labels" name="02. Связи сущностей через labels">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2_title" value="02. Как сущности находят друг друга: селекторы (labels)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="680" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2_dep" value="Deployment web&#xa;spec.selector.matchLabels: app=demo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2_rs" value="ReplicaSet web-7c9d&#xa;selector: app=demo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2_pod1" value="Pod web-7c9d-abcde&#xa;labels: app=demo | 10.244.1.7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2_pod2" value="Pod web-7c9d-fghij&#xa;labels: app=demo | 10.244.2.3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="290" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2_svc" value="Service web-svc&#xa;spec.selector: app=demo&#xa;ClusterIP + DNS «web-svc»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="100" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2_ep" value="Endpoints (заполняет контроллер)&#xa;10.244.1.7:80&#xa;10.244.2.3:80" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="270" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2_np" value="NetworkPolicy allow-frontend&#xa;podSelector: app=demo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="430" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2_note" value="Выводы: селектор Deployment ↔ метки шаблона подов обязаны совпадать (selector иммутабелен). Смена метки у пода мгновенно меняет его Endpoints — Service и NetworkPolicy перестраиваются без перезапуска. Ingress → Service и HPA → Deployment ссылаются по ИМЕНИ, не по меткам." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="850" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="p2_dep" target="p2_rs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="p2_rs" target="p2_pod1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e3" value="селектор → список IP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="p2_svc" target="p2_ep">
          <mxGeometry relative="1" as="geometry" />
