        <mxCell id="p3_dns" value="CoreDNS&#xa;web-svc → 10.96.0.15" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="340" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3_pod1" value="Pod web-xxx :8080 (Ready)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="570" y="340" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3_pod2" value="Pod web-yyy :8080 (Ready)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="340" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3_kp" value="kube-proxy (iptables/IPVS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="570" y="450" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3_note" value="Ключевые точки: Ingress ссылается на Service по имени; Service находит поды по селектору меток; в балансировку попадают только Ready-поды (readinessProbe — gate); CoreDNS даёт сервисам стабильные имена." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="940" height="60" as="geometry" />
