          <mxGeometry x="260" y="200" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3_svc" value="Service web-svc&#xa;ClusterIP 10.96.0.15:80&#xa;selector: app=demo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="570" y="205" width="230" height="70" as="geometry" />
