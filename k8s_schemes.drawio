        <mxCell id="p3_ic" value="Ingress Controller&#xa;(ingress-nginx / traefik)&#xa;NodePort или LoadBalancer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
