          <mxGeometry x="40" y="240" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4_pvc" value="PVC data-db-0&#xa;storageClassName: local-ssd&#xa;accessModes: RWO, 10Gi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="140" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p4_pv" value="PV pvc-8f3a&#xa;10Gi, RWO&#xa;reclaimPolicy: Retain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="140" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p4_sc" value="StorageClass local-ssd&#xa;provisioner: ebs.csi.aws.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="300" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_note" value="Логика: PVC — «заявка» разработчика, PV — выделенный ресурс, StorageClass — шаблон автосоздания PV. StatefulSet создаёт по PVC на реплику (data-db-0, data-db-1…). Удаление StatefulSet НЕ удаляет PVC. reclaimPolicy: Retain — данные сохраняются после удаления PVC; Delete — удаляется и диск." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="580" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p4_e1" value="по PVC на каждую реплику" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="p4_sts" target="p4_pvc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e2" value="монтирует" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="p4_pod" target="p4_pvc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e3" value="Bound" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="p4_pvc" target="p4_pv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e4" value="динамический провижининг" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;dashPattern=4 4;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="p4_sc" target="p4_pv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p5-cicd" name="05. Конвейер CI-CD">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p5_title" value="05. Конвейер CI/CD: от коммита до прода (GitLab)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p5_dev" value="Разработчик&#xa;git push / MR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5_gitlab" value="GitLab&#xa;репозиторий +&#xa;.gitlab-ci.yml (rules, stages)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="75" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5_runner" value="GitLab Runner&#xa;executor: docker / shell" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="200" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p5_reg" value="Container Registry&#xa;myapp:main-a1b2c3d" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="80" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5_s1" value="validate&#xa;lint + unit-тесты" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5_s2" value="build&#xa;docker build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="210" y="330" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5_s3" value="test&#xa;интеграционные" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="330" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5_s4" value="security&#xa;hadolint + trivy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="330" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5_s5" value="deploy: staging&#xa;(авто, из main)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="330" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5_s6" value="deploy: production&#xa;(when: manual)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="890" y="330" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5_note" value="Каждая стадия — quality gate: упавший job останавливает движение дальше. Между job данные передаются через artifacts (артефакты) и cache (кеш). Runner подбирается по тегам: сборка образов — docker executor + dind, деплой — shell executor. Откат: прежний тег образа / kubectl rollout undo / helm rollback." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="1010" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="p5_dev" target="p5_gitlab">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_e2" value="job из очереди" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="p5_gitlab" target="p5_runner">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="p5_runner" target="p5_s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="p5_s1" target="p5_s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="p5_s2" target="p5_s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="p5_s3" target="p5_s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="p5_s4" target="p5_s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_e8" value="по кнопке" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="p5_s5" target="p5_s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_e9" value="docker push" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="p5_s2" target="p5_reg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_e10" value="docker pull" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;dashPattern=4 4;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="p5_reg" target="p5_s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
